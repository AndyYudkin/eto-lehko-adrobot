# Скопируйте в .env и заполните: cp .env.example .env
# .env в git не попадает.
# Обязательно заменить: KT_API_KEY, APP_PASSWORD, JWT_SECRET (./setup.sh сделает это сам).

# --- Запуск ---
# Порт, на котором откроется приложение: http://localhost:8080
APP_PORT=8080

# --- Keitaro Admin API ---
# Адрес трекера без /admin_api/v1 на конце
KT_URL=https://tlgk.host
KT_API_KEY=change-me

# Домен, группа и источник для новых кампаний (ищутся по названию; не создаются)
# KT_DOMAIN можно оставить пустым — возьмётся первый активный домен
KT_DOMAIN=kylovoa.com
KT_GROUP=FORTESTS
KT_TRAFFIC_SOURCE=FORTESTS

# Префикс для названий новых кампаний: вводишь campaign1 — в Keitaro создаётся test_<фамилия>_campaign1.
# Если название уже начинается с префикса, он не дублируется. Пусто — без префикса.
CAMPAIGN_NAME_PREFIX=test_iudkin_

# --- Вход в приложение ---
# Единственный пользователь; при старте бэка записывается в таблицу users (пароль — bcrypt-хешем)
APP_LOGIN=admin
APP_PASSWORD=change-me

# --- Токены ---
# Секрет подписи JWT, длинная случайная строка: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# true — cookie только по HTTPS; для локального запуска по http оставить false
COOKIE_SECURE=false

# --- Postgres ---
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=adrobot
POSTGRES_DB=adrobot

# --- Только для разработки ---
# Открыть Postgres (5432) и бэк (8000) наружу — для pytest и npm run dev:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# Бэк вне Docker и тесты ходят в базу через localhost
# (в Docker DATABASE_URL собирается из POSTGRES_* в docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@localhost:5432/adrobot
# TEST_DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@localhost:5432/adrobot_test
